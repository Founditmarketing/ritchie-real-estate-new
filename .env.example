# Lead delivery — "Ask Ritchie" chat + the Sell valuation form email leads here.
# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.

# Your Resend API key (https://resend.com → API Keys). Required to send.
RESEND_API_KEY=

# Where leads land. Comma-separate for multiple inboxes.
LEAD_TO_EMAIL=matt@example.com

# The "from" address. For best deliverability, verify your domain in Resend
# and use it here. Until then, leave blank to use Resend's test sender
# (onboarding@resend.dev), which only delivers to your Resend account email.
LEAD_FROM_EMAIL="Ritchie Leads <onboarding@resend.dev>"

# --- Optional future upgrade: real LLM brain for the chatbot ---
# Drop one of these in and wire the seam in src/app/api/chat/route.ts.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
